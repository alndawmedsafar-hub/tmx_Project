<!DOCTYPE html>
<html lang="ku" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1200">
    <title>TMX TERMINAL UNIVERSE</title>
    <style>
        :root { --neon: #00ff41; --accent: #bc13fe; --bg: #050505; }
        body { margin: 0; background: var(--bg); color: var(--neon); font-family: 'Courier New', monospace; overflow: hidden; }
        .desktop { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 20px; padding: 30px; }
        .icon { text-align: center; cursor: pointer; transition: 0.3s; }
        .icon:hover { filter: drop-shadow(0 0 10px var(--accent)); transform: translateY(-5px); }
        .window { position: absolute; width: 85%; height: 80%; background: rgba(0,0,0,0.95); border: 2px solid var(--accent); border-radius: 10px; display: none; flex-direction: column; top: 5%; left: 7.5%; z-index: 100; box-shadow: 0 0 40px rgba(188,19,254,0.3); }
        .win-head { background: var(--accent); color: #fff; padding: 10px; display: flex; justify-content: space-between; font-weight: bold; }
        .win-body { flex: 1; padding: 20px; overflow-y: auto; text-align: left; direction: ltr; }
        .line { display: flex; border-bottom: 1px solid #111; padding: 3px 0; font-size: 13px; }
        .ln { color: #555; width: 45px; border-right: 1px solid #222; margin-right: 10px; }
        .terminal { background: #000; border: 1px solid var(--neon); padding: 15px; height: 200px; overflow-y: auto; margin-top: 10px; }
        input { background: transparent; border: none; color: #fff; outline: none; width: 80%; font-family: monospace; font-size: 16px; }
    </style>
</head>
<body>

    <div class="desktop">
        <div class="icon" onclick="openWin('core')"><span>🌀</span><p>Core</p></div>
        <div class="icon" onclick="openWin('hack')"><span>💀</span><p>Hacking</p></div>
        <div class="icon" onclick="checkOffice()"><span>👑</span><p>TMX_OFFICE</p></div>
    </div>

    <div id="win-box" class="window">
        <div class="win-head"><span id="win-title">TMX_SYSTEM</span><span style="cursor:pointer" onclick="closeWin()">✕</span></div>
        <div class="win-body" id="win-content"></div>
    </div>

    <div style="position:fixed; bottom:20px; width:90%; left:5%; z-index:50;">
        <div class="terminal" id="term-out">Welcome Commander TMX... Type 'help' to start.</div>
        <div style="background:#111; padding:10px; border:1px solid var(--neon);">
            <span>tmx@honor-x9c:~$ </span><input type="text" id="cmd-in" onkeypress="runCmd(event)">
        </div>
    </div>

    <script>
        const PASS = "2010aa";
        function openWin(type) {
            document.getElementById('win-box').style.display = 'flex';
            document.getElementById('win-title').innerText = type.toUpperCase() + " OCEAN";
            load1500(type);
        }
        function closeWin() { document.getElementById('win-box').style.display = 'none'; }

        function checkOffice() {
            if(prompt("PASSWORD:") === PASS) { openWin('office'); }
            else { alert("INVALID KEY!"); }
        }

        function load1500(mode) {
            const body = document.getElementById('win-content');
            body.innerHTML = "";
            let html = "";
            for(let i=1; i<=1500; i++) {
                let cmd = (mode === 'core') ? `pkg install lib-tmx-v${i}` : (mode === 'hack') ? `git clone tmx/exploit-${i}` : `tmx-vip-exec --key-${i}`;
                html += `<div class="line"><span class="ln">${i}</span><code>${cmd}</code><span style="color:#666; margin-left:10px;">// فەرمانی ${i}</span></div>`;
            }
            body.innerHTML = html;
        }

        function runCmd(e) {
            if(e.key === "Enter") {
                const out = document.getElementById('term-out');
                const val = document.getElementById('cmd-in').value.toLowerCase();
                out.innerHTML += `<br>> ${val}`;
                if(val === "help") out.innerHTML += "<br>Try: nmap, clear, whoami, pkg install";
                else if(val === "whoami") out.innerHTML += "<br>TMX_COMMANDER_X9c";
                else if(val === "clear") out.innerHTML = "Cleared.";
                else out.innerHTML += `<br>Executing ${val}... Done.`;
                document.getElementById('cmd-in').value = "";
                out.scrollTop = out.scrollHeight;
            }
        }
    </script>
</body>
</html>
